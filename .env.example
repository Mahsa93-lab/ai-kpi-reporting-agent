# Copy to .env and fill in – .env is in .gitignore and must never be committed.

# OpenAI API key (platform.openai.com → API keys). Used once by n8n/setup.sh, then stored encrypted in n8n.
OPENAI_API_KEY=

# Encrypts the credentials inside n8n. Any long random string, e.g. from:
#   python -c "import secrets; print(secrets.token_hex(32))"
N8N_ENCRYPTION_KEY=

# Search API of project 3 (EU AI Act / GDPR). Optional – without it the chat says the lookup is unavailable.
# REGULATION_API_URL=http://host.docker.internal:8000

# Only for scripts/evaluate_agent.py: price of the model in USD per 1 million tokens (same values as in project 3)
PRICE_INPUT_PER_M=
PRICE_OUTPUT_PER_M=
# CHAT_MODEL=gpt-6-luna
# REASONING_EFFORT=low
